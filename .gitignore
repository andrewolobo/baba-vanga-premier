__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
build/
dist/
.venv/
venv/

# Local database and generated artifacts. Migrations are tracked; the DB is not.
db/*.db
db/*.db-journal
db/*.db-wal
db/*.db-shm
# run_cycle.sh's overlap guard. It lives beside the database because the
# systemd units set PrivateTmp=true, which would make a /tmp lock invisible
# between the service and a hand-run shell -- the exact overlap it is for.
db/*.lock
artifacts/

# Node (web/ arrives in Week 1 Track A)
node_modules/
.svelte-kit/

.env
.env.local

# Frozen serving artifacts are reproducible outputs, not source.
db/artifacts/

# fbref scraper: the raw HTML cache and scraped output are reproducible, and
# the Chrome profile and session file hold live Cloudflare cookies.
data/fbref/

# stadium_coords: cached Wikidata and LocationIQ responses. Reproducible, and
# re-fetching them costs one SPARQL query plus ~150 geocodes. The built table
# at reference/stadiums.csv IS tracked -- it is reviewed input, not output.
data/stadiums/

# Scheduled-cycle logs. Operational output, not source; the durable record of
# what a cycle did is its serving_state row.
logs/

# web/static/ is published verbatim -- nginx serves it from the build root, so
# anything dropped in there becomes a public URL. player.rar is the hero
# image's source archive and has no business being downloadable from the site.
# Design SOURCE belongs in docs/ui/, which is never served.
web/static/*.rar
