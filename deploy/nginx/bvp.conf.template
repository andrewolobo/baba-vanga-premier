# nginx site for baba.vanga.premier. See docs/DEPLOY.md 5.3.
#
# A TEMPLATE, rendered once into /etc/nginx/sites-available/bvp:
#
#     BVP_DOMAIN=example.com \
#       envsubst '$BVP_DOMAIN' < deploy/nginx/bvp.conf.template \
#       | sudo tee /etc/nginx/sites-available/bvp
#     sudo ln -sf /etc/nginx/sites-available/bvp /etc/nginx/sites-enabled/bvp
#     sudo nginx -t && sudo systemctl reload nginx
#
# It is a template rather than a finished file for two reasons, both from
# docs/DEPLOY.md 3.6 -- the working tree on the server must stay clean or the
# next `git pull` is a conflict on a matchday:
#
#   - the domain is environment, so it must not be a tracked constant;
#   - `certbot --nginx` REWRITES the site file it manages. So certificates are
#     obtained with `certonly --webroot` instead (see below), which touches
#     nothing here. Renewal then replaces only the files under /etc/letsencrypt
#     and this config keeps pointing at them.
#
# First run, before any certificate exists, the 443 block cannot load. Use
# deploy/nginx/bvp-bootstrap.conf.template for long enough to issue the cert:
#
#     sudo certbot certonly --webroot -w /var/www/certbot \
#       --cert-name ${BVP_DOMAIN} -d ${BVP_DOMAIN} -d www.${BVP_DOMAIN} \
#       --deploy-hook "systemctl reload nginx"
#
# then render this file over it and reload. Both names, because the last
# server below answers www over TLS with this certificate. The deploy hook is
# saved into the renewal config: without it a renewed certificate sits on
# disk while nginx keeps serving the old one until it expires.

# Keep the API out of search indexes (docs/SEO_PLAN.md 1.3): X-Robots-Tag on
# every /api/ response, nothing anywhere else -- an empty value sends no
# header. Not robots.txt: that was chosen while pages were client-rendered
# and a crawler had to FETCH /api/tips to see a call. Since SEO_PLAN.md 2.1
# the calls are in the HTML, so a Disallow would no longer blank a page, but
# noindex already stops the JSON being listed as a result of its own.
#
# A map rather than an add_header in each /api/ location, because nginx drops
# every inherited add_header in a location that declares one of its own: the
# per-location form would have to repeat nosniff and the referrer policy five
# times, and a sixth location would lose all three silently.
# tests/test_nginx_routes.py pins that no /api/ location sets headers. `map`
# is http-level, which this file is: Ubuntu's nginx.conf includes
# sites-enabled inside `http {}`.
map $uri $bvp_robots_tag {
    ~^/api/  "noindex";
    default  "";
}

server {
    listen 80;
    listen [::]:80;
    server_name ${BVP_DOMAIN} www.${BVP_DOMAIN};

    # ACME renewal must keep working over plain HTTP, so it is matched before
    # the redirect rather than after it. It serves www too: the certificate
    # covers both names, and renewal proves each one over port 80.
    location /.well-known/acme-challenge/ { root /var/www/certbot; }

    # To the apex whichever name was asked for, so http://www reaches the one
    # canonical host in a single hop (docs/SEO_PLAN.md 1.4).
    location / { return 301 https://${BVP_DOMAIN}$request_uri; }
}

server {
    # `http2` on the listen line, not the standalone `http2 on;` directive --
    # that form needs nginx >= 1.25.1 and Ubuntu's package is older.
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name ${BVP_DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${BVP_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${BVP_DOMAIN}/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header X-Robots-Tag $bvp_robots_tag always;

    # `npm run build` writes the page server to web/build/ and its static
    # files to web/build/client/. Only the latter is ever served as files:
    # build/ itself holds the server's code (docs/SEO_PLAN.md 2.1).
    root /srv/bvp/web/build/client;

    # ------------------------------------------------------------------ #
    # THE PROXY. This is docs/DEPLOY.md 2.4 -- the blocker this file exists
    # for. web/src/lib/api.js sets BASE = '/api' and every call is
    # origin-relative; in development web/vite.config.js proxies /api to
    # uvicorn AND rewrites the prefix away. There is no Vite in production, so
    # nginx has to reproduce both halves.
    #
    # The TRAILING SLASH on proxy_pass is what strips /api. Without it uvicorn
    # receives /api/tips, answers 404, and -- because the frontend renders an
    # empty list rather than an error for an empty week -- the whole site reads
    # as "no matches this week" instead of as a misconfiguration. That failure
    # mode is already documented in web/vite.config.js for the same reason.
    # ------------------------------------------------------------------ #
    location /api/ {
        proxy_pass http://127.0.0.1:8000/;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 30s;
    }

    # Sign-in (docs/AUTH_PLAN.md D13). The three account writes and the
    # config read are the only unauthenticated endpoints that do work per
    # hit -- /auth/google makes an outbound call to Google's certificate
    # endpoint -- so they get a lid the rest of /api/ does not need. The zone
    # is declared in deploy/nginx/bvp-limits.conf (conf.d). A prefix location
    # is matched longest-first, so /api/auth/ wins over /api/ above; the
    # phone write is an exact match. Both proxy_pass lines strip /api the
    # same way as the main block.
    location /api/auth/ {
        limit_req zone=bvp_auth burst=10 nodelay;
        proxy_pass http://127.0.0.1:8000/auth/;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 30s;
    }
    location = /api/me/phone {
        limit_req zone=bvp_auth burst=10 nodelay;
        proxy_pass http://127.0.0.1:8000/me/phone;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 30s;
    }

    # The internal views, fenced off. docs/DEPLOY.md 3.1: /performance returns
    # `pnl` and `roi` and /book returns paper_bets.*, and B7's honesty test
    # covers /tips/record ONLY. Both are empty today because the book is off --
    # this is here so that stops being the only thing standing between a public
    # URL and a published return.
    #
    # Exact-match locations are evaluated before the /api/ prefix above, so each
    # needs its own proxy_pass. A query string is not part of the match, so
    # /api/book?settled=true still lands here.
    location = /api/book {
        auth_basic "internal";
        auth_basic_user_file /etc/nginx/.htpasswd-bvp;
        proxy_pass http://127.0.0.1:8000/book;
        proxy_set_header Host $host;
    }
    location = /api/performance {
        auth_basic "internal";
        auth_basic_user_file /etc/nginx/.htpasswd-bvp;
        proxy_pass http://127.0.0.1:8000/performance;
        proxy_set_header Host $host;
    }

    # FastAPI's generated docs (docs/SEO_PLAN.md D6): an indexable HTML page
    # and a map of every route, the fenced ones included. Closed here only;
    # uvicorn still serves them in development. A regex location outranks the
    # /api/ prefix, and (/|$) also catches /api/docs/oauth2-redirect.
    location ~ ^/api/(docs|redoc|openapi\.json)(/|$) {
        return 404;
    }

    # Vite emits content-hashed filenames under /_app/immutable, so they are
    # immutable. Not the rest of /_app: version.json is how an open tab learns
    # a deploy happened, and a year-long cache would hide it.
    location /_app/immutable/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # THE PAGES. A static file is served from disk; every other path is a
    # page, rendered by the Node service (deploy/systemd/bvp-web.service,
    # docs/SEO_PLAN.md 2.1) with its content in the HTML. SvelteKit answers
    # 404 itself for a path that is no route, so there is no route list here
    # to keep in step with web/src/routes -- the 1.2 regex went with the
    # client-rendered shell it rewrote to.
    #
    # No add_header in @web, so pages keep the server-level nosniff,
    # referrer policy and (empty) X-Robots-Tag; tests/test_nginx_routes.py
    # pins it. Pages set no Cache-Control and are rendered per request.
    location / {
        try_files $uri @web;
    }
    location @web {
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 30s;
    }

    # The service worker must never be cached either: a browser holding a stale
    # worker keeps serving the old build it precached, surviving deploys.
    location = /service-worker.js {
        add_header Cache-Control "no-cache";
    }
}

# www, over TLS: redirect only, never the site (docs/SEO_PLAN.md 1.4). One
# canonical host for search engines, and nothing served from www means no
# second origin for Google sign-in or the session cookie. Needs the
# certificate to name www.${BVP_DOMAIN} -- see the certbot line at the top.
# Last in the file, so the site above stays the default server for 443.
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name www.${BVP_DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${BVP_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${BVP_DOMAIN}/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;

    return 301 https://${BVP_DOMAIN}$request_uri;
}
