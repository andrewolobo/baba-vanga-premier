# The read-only serving API. docs/DEPLOY.md 5.5.
#
#   sudo cp deploy/systemd/bvp-api.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now bvp-api
#
# Copied rather than symlinked from the repo: a `git pull` that changed a unit
# under systemd's nose would leave the running service and the file on disk
# disagreeing, with nothing to say so. Copy, then `daemon-reload` deliberately.

[Unit]
Description=baba.vanga.premier API (read-only serving layer)
Documentation=file:/srv/bvp/docs/DEPLOY.md
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=bvp
Group=bvp

# api/ is not an installed package -- pyproject's packages.find includes
# engine* only -- so the repo root has to be the working directory.
# docs/DEPLOY.md 3.4.
WorkingDirectory=/srv/bvp

# Bound to loopback. nginx is the only thing that should reach it, and it is
# what enforces basic auth on /api/book and /api/performance (docs/DEPLOY.md
# 3.1). An API listening on 0.0.0.0 would let anyone bypass that by going
# straight to the port.
#
# ONE worker, deliberately. The API is read-only and Postgres takes any
# number of readers, so more would work -- there is simply no load here that
# needs them.
ExecStart=/srv/bvp/.venv/bin/uvicorn api.main:app --host 127.0.0.1 --port 8000

Restart=always
RestartSec=5

# ProtectSystem=strict makes the whole hierarchy read-only, so the bytecode
# cache is unwritable; saying so explicitly beats letting Python discover it on
# every import.
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1

# The store. Database `bvp` on the VM's own Postgres over the local socket,
# peer-authenticated as this unit's user -- no password anywhere. Set here,
# not in a .env, so what the service reads is what `systemctl cat` shows
# (docs/DEPLOY.md 3.10, docs/POSTGRES_PLAN.md).
Environment=BVP_DATABASE_URL=postgresql:///bvp

# --- hardening ----------------------------------------------------------- #
# The API talks to Postgres on a local socket and answers HTTP. It needs
# nothing else -- and, unlike the SQLite days, no writable path at all: the
# WAL sidecars that once forced `ReadWritePaths=/srv/bvp/db` are gone.
# Connecting to the socket under /var/run/postgresql works under
# ProtectSystem=strict (a read-only mount refuses writes to regular files,
# not connects to sockets); DEPLOY.md 5.5 checks it on the VM regardless.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
