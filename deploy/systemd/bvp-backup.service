# Daily snapshot of the serving database. docs/DEPLOY.md 6.1.
#
#   sudo cp deploy/systemd/bvp-backup.{service,timer} /etc/systemd/system/
#   sudo install -d -o bvp -g bvp /var/backups/bvp
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now bvp-backup.timer     # the TIMER, not the service
#
# A SEPARATE unit from bvp-cycle rather than an ExecStartPost on it.
# ExecStartPost does not run when ExecStart fails, and the cycle's steps are
# deliberately independent -- a run that failed at `grade` may still have
# written predictions at `serve`. The backup must not inherit the cycle's
# verdict, so it is scheduled 30 minutes behind it instead.

[Unit]
Description=baba.vanga.premier database snapshot
Documentation=file:/srv/bvp/docs/DEPLOY.md

[Service]
Type=oneshot
User=bvp
Group=bvp
WorkingDirectory=/srv/bvp
ExecStart=/srv/bvp/scripts/backup.sh --dir /var/backups/bvp --keep 7

# Unlike the cycle, there is no "ran but needs a look" state here: either a
# verified snapshot exists or it does not. So no SuccessExitStatus, and any
# non-zero is a real failure.
TimeoutStartSec=15min

Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
Environment=BVP_DATABASE_URL=postgresql:///bvp

# Set this to send snapshots off the VM. Until it is set, backup.sh warns on
# every run that the copies live only on the machine they protect.
#   Environment=BVP_BACKUP_CONTAINER=bvp-backups

# --- hardening ----------------------------------------------------------- #
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
LockPersonality=true

# Only the output directory: `pg_dump` reads the store over the socket and
# writes nothing under the repo.
ReadWritePaths=/var/backups/bvp

# No [Install] section -- the timer starts it. Enabling it directly would also
# snapshot at every boot.
